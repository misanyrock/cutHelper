{
  "name": "cuthelper",
  "version": "0.1.2",
  "private": true,
  "description": "离线口播自动粗剪桌面工具",
  "author": "CutHelper",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node --import tsx scripts/desktop-smoke.ts",
    "pack": "npm run build && node scripts/media-resources.mjs && electron-builder --dir --publish never",
    "dist:mac": "npm run build && node scripts/media-resources.mjs && electron-builder --mac dmg --publish never",
    "dist:win": "npm run build && node scripts/media-resources.mjs && electron-builder --win nsis --publish never",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "ffmpeg-static": "^5.3.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "local.cuthelper.desktop",
    "productName": "CutHelper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**/*",
      "!node_modules/@ffprobe-installer/ffprobe/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "media-resources",
        "to": "media"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": "dmg",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronDist": "node_modules/electron/dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/misanyrock/cutHelper.git"
  },
  "bugs": {
    "url": "https://github.com/misanyrock/cutHelper/issues"
  },
  "homepage": "https://github.com/misanyrock/cutHelper#readme"
}
